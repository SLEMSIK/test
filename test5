# Перезапуск Signage: внешние запросы через curl и школьный прокси
sudo -u signage -H env PM2_HOME=/var/lib/signage/.pm2 \
  NODE_OPTIONS=--require=/etc/signage/curl-fetch.cjs \
  HTTPS_PROXY=http://10.0.33.52:3128 HTTP_PROXY=http://10.0.33.52:3128 \
  NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12 \
  pm2 restart signage --update-env
sudo -u signage -H env PM2_HOME=/var/lib/signage/.pm2 pm2 save
EOF
